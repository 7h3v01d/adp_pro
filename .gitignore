# Virtual environment
.venv/
venv/

# Editable-install / build metadata
*.egg-info/
*.egg-link
build/
dist/
.eggs/

# Python caches
__pycache__/
*.py[cod]
*.pyo

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# venv-bat-gen companion scripts (regenerated by setup.bat on first run)
run.bat
pip.bat
shell.bat
sync.bat
doctor.bat
test.bat

# Runtime settings are per-user (app-data dir), never in the repo.
# settings.example.json documents the shape and IS committed.
/settings.json
src/settings.json

# Logs
*.log
*.zip

# OS noise
.DS_Store
Thumbs.db
